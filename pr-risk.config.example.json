{
  "$schema": "./pr-risk.schema.json",
  "baseBranch": "main",
  "failThreshold": 70,
  "severityThresholds": {
    "medium": 30,
    "high": 60,
    "critical": 80
  },
  "criticalPaths": [
    "/auth",
    "/payments",
    "/migrations"
  ],
  "maxFunctionLines": 50,
  "maxCyclomaticComplexity": 12,
  "maxNestingDepth": 4,
  "maxClassLines": 250,
  "maxClassMethods": 15,
  "duplicateMinLines": 6,
  "duplicateMinTokens": 50,
  "ignoreFiles": [
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "dist/",
    "build/",
    ".next/"
  ],
  "testPatterns": [
    "\\.test\\.[jt]sx?$",
    "\\.spec\\.[jt]sx?$",
    "(^|/)__tests__/",
    "(^|/)tests?/"
  ],
  "disabledRules": [],
  "suppressions": [],
  "weights": {
    "filesChanged": 10,
    "linesChanged": 15,
    "missingTests": 15,
    "criticalPaths": 20,
    "duplicateCode": 8,
    "largeFunctions": 12,
    "riskyPatterns": 12,
    "dependencyAndConfig": 8
  }
}
